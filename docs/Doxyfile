# Doxyfile for Elysia ECS
PROJECT_NAME            = "Elysia ECS"
OUTPUT_DIRECTORY       = docs/doxygen
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_HTML          = NO
GENERATE_XML           = YES
RECURSIVE              = YES
INPUT                  = ElysiaECS/src
FILE_PATTERNS          = *.cppm *.cpp *.h
EXTENSION_MAPPING      = cppm=C++
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
# XML output is essential for Exhale
XML_OUTPUT             = xml
